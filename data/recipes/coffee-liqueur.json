  "directions": [
    {
      "_id": "68569dee32ecade4c7b8afd4",
      "step": "Place all the ingredients except the cream in an appropriate-sized canning jar. Secure the lid and macerate for 6 days."
    },
    {
      "_id": "68569df532ecade4c7b8afd5",
      "step": "The day the maceration is completed, sterilize the bottles. Place them in a sink and fill with boiling water. After a few minutes, drain them and let them cool."
    },
    {
      "_id": "68569dfb32ecade4c7b8afd6",
      "step": "Filter the alcohol through a clean “gold” type filter into a clean jar. When filtering be sure to use a filter normally used for brewing coffee, so as not to taint the one used for other liqueur flavors."
    },
    {
      "_id": "68569e0132ecade4c7b8afd7",
      "step": "Boil water. Remove from stove and add sugar to dissolve, stirring slowly."
    },
    {
      "_id": "68569e0a32ecade4c7b8afd8",
      "step": "Bottle the liqueur when ingredients have cooled. Let the air bubbles escape before corking."
    },
    {
      "_id": "68569e1132ecade4c7b8afd9",
      "step": "Serve in cordial glasses, with a small layer of heavy cream floated on top. This liqueur is approx 42 proof."
    }
  ],
