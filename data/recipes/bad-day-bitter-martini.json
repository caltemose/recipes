  "directions": [
    {
      "_id": "685699b232ecade4c7b8af8d",
      "step": "Wrap ice cubes in a clean towel and smack it against the counter a few times to crush. Fill a martini glass with 1 C of crushed ice. Add the remaining ice to a cocktail shaker."
    },
    {
      "_id": "685699b832ecade4c7b8af8e",
      "step": "Add gin and Montenegro and stir until chilled, about 15 seconds. Discard the ice from the martini glass and strain the gin mixture into the glass. Garnish with grapefruit peel."
    }
