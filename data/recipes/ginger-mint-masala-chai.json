  "directions": [
    {
      "_id": "6856a07632ecade4c7b8affd",
      "step": "Take 2” of ginger root and peel it with a peeler or metal dinnerware spoon. Grate the ginger."
    },
    {
      "_id": "6856a07c32ecade4c7b8affe",
      "step": "Add water, black tea, tea masala, ginger and mint leaves to a stove pot. Turn on medium-high until water is boiling. Stir if needed to break up any clumps of tea masala."
    },
    {
      "_id": "6856a08332ecade4c7b8afff",
      "step": "Pour in milk and stir once. Keep heating until milk is about to boil over. Keep watch at this stage as milk can quickly boil over the pot. Once the milk starts to rise up as if about to boil over, turn off the stove."
    },
    {
      "_id": "6856a08932ecade4c7b8b000",
      "step": "Strain the tea as you pour into mugs. Add sugar to taste."
    }
  ],
  "__v": 14
