  "directions": [
    {
      "_id": "6850ac7632ecade4c7b8ade0",
      "step": "Warm the oil and butter in a heavy-bottomed pot placed over medium heat. When the butter is melted and begins to sizzle, add the onion, carrots and celery and sauce, stirring often, for about 15 minutes or until the vegetables are softened. If necessary, reduce the heat to medium-low to prevent the vegetables from browning."
    },
    {
      "_id": "6850ac8032ecade4c7b8ade1",
      "step": "While the vegetables are cooking, pass the tomatoes through a food mill fitted with the disk with the smallest holes. Discard the solids."
    },
    {
      "_id": "6850ac8932ecade4c7b8ade2",
      "step": "Add the milled tomatoes to the vegetables and stir in 1 teaspoon salt and several grids of black pepper. Cover partially and cook at a gentle simmer for 45 minutes, or until the vegetables are completely tender. Remove from the heat and let the sauce cool for 10 minutes."
    },
    {
      "_id": "6850ac9132ecade4c7b8ade3",
      "step": "Pure the sauce using an immersion blender. Add the cream, place over medium heat, and bring the sauce just to a simmer. Taste and add salt and pepper if needed."
    },
    {
      "_id": "6850ac9932ecade4c7b8ade4",
      "step": "The sauce may be stored in a tightly lidded contained in the fridge for up to 3 days or in the freezer for up to 3 months. If freezing, omit the cream and add it when you reheat the sauce."
    }
  ],
  "__v": 16
