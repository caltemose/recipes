  "directions": [
    {
      "_id": "685341a232ecade4c7b8aea5",
      "step": "Wash the asparagus and break off the fibrous ends. Cut into halves and cook in boiling salted water for about 5 minutes. Drain off the water and allow the asparagus to cool. Preheat the oven to 170 C (340 F) with fan. Oil 8 metal molds each with a capacity of 100 ml (1/2 C) and dust with a little semolina."
    },
    {
      "_id": "685341a932ecade4c7b8aea6",
      "step": "With a stick mixer, blend the asparagus, ricotta, eggs, garlic and herbs and season with salt and pepper."
    },
    {
      "_id": "685341b532ecade4c7b8aea7",
      "step": "Fill the molds three-quarters full with the asparagus mixture and place them in a high-sided oven-proof tray. Fill with water to half way up the molds and bake in a water bath for 30 minutes on the second rack from the bottom of the oven."
    },
    {
      "_id": "685341be32ecade4c7b8aea8",
      "step": "Switch off the oven and allow the molds to rest in the oven for about 10 minutes."
    },
    {
      "_id": "685341c632ecade4c7b8aea9",
      "step": "In the meantime, wash the greens for the salad and drizzle with lemon juice, olive oil, salt and pepper. Arrange the salad on plates and add 2 asparagus flans on each plate. Drizzle with a little olive oil. If desired, sprinkle some dried petals over the plates."
    }
  ],
  "__v": 21
