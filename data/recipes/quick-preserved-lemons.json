  "directions": [
    {
      "_id": "68569ad032ecade4c7b8afa2",
      "step": "Remove top and tail from each lemon."
    },
    {
      "_id": "68569ad932ecade4c7b8afa3",
      "step": "Slice each lemon into 8 wedges, removing any seeds."
    },
    {
      "_id": "68569ae932ecade4c7b8afa4",
      "step": "Layer sliced lemons in a wide-mouthed jar - sprinkling with salt at each layer."
    },
    {
      "_id": "68569af132ecade4c7b8afa5",
      "step": "Top the jar with any remaining lemon juice, leaving about 1/2 inch of head space in the jar."
    },
    {
      "_id": "68569af832ecade4c7b8afa6",
      "step": "Stash in the refrigerator for 4 days, then flip the bottle over and age another 4 days before sampling.&nbsp; The peel should be nice and soft."
    },
    {
      "_id": "68569b0032ecade4c7b8afa7",
      "step": "This can be used immediately or kept in the fridge for up to 3 months."
    }
