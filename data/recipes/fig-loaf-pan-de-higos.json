  "directions": [
    {
      "_id": "6855580b32ecade4c7b8aefb",
      "step": "In a food processor, combine the figs, almonds, hazelnuts, 1/2 C powered sugar, cinnamon, cloves and lemon zest. Pulse until well combined. Stir in the liqueur or brandy and chocolate to moisten the mixture, which will be very stiff."
    },
    {
      "_id": "6855581232ecade4c7b8aefc",
      "step": "Sprinkle a large square of heavy-duty aluminum foil with powdered sugar. Shape the fig mixture into a large loaf and wrap it in the foil. Refrigerate for at least 2 days or as long as 3 months."
    },
    {
      "_id": "6855581e32ecade4c7b8aefd",
      "step": "To serve, dip a very sharp knife in hot water and cut the loaf into slices."
    }
  ],
  "__v": 16
