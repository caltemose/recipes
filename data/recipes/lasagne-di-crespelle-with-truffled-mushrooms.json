  "directions": [
    {
      "_id": "6850a81f32ecade4c7b8ada0",
      "step": "Put the porcini in a small heatproof bowl and pour the boiling water over them. Let stand for 20-30 minutes, or until softened.&nbsp;"
    },
    {
      "_id": "6850a82732ecade4c7b8ada1",
      "step": "Drain the porcini in a fine-mesh sieve lined with damp paper towels or cheesecloth, reserving the liquid. Chop the mushrooms coarsely and set the mushrooms and liquid aside separately."
    },
    {
      "_id": "6850a83132ecade4c7b8ada2",
      "step": "Put the olive oil, 1 T butter, and garlic in a large frying pan on medium heat. When the butter is melted, reduce the heat to medium-low and sautéed the garlic for about 5 minutes, or until softened but not browned."
    },
    {
      "_id": "6850a83832ecade4c7b8ada3",
      "step": "Add the porcini and the fresh mushrooms and sprinkler with 1 t salt and some pepper. Stir the mushrooms with a wooden spoon or spatular to coat them with the oil and butter. Sauce for about 20 minutes, or until the mushrooms are tender and the liquid they release has evaporated.&nbsp;"
    },
    {
      "_id": "6850a84032ecade4c7b8ada4",
      "step": "Raise the heat to high and pour in the wine and porcini liquid. Stir, and then let the liquid bubble for a minute or so. Reduce the heat to medium-low and continue to cook for about 5 minutes, or until most of the liquid has evaporated. Taste and adjust the seasoning with salt or pepper if needed. Remove from the heat and stir in the parsley."
    },
    {
      "_id": "6850a84c32ecade4c7b8ada5",
      "step": "Heat the oven to 375 degrees F. Lightly coat a 12-inch round or 9x13 baking pan with butter."
    },
    {
      "_id": "6850a84c32ecade4c7b8ada6",
      "step": "Arrange 4 or 5 crespelle in the prepared dish, overlapping them where necessary to form a thin layer that covers as much of the bottom of the dish as possible. Spoon one-fourth of the mushrooms over the crespelle and spread them out gently in an even layer. Sprinkler one-fourth of the mozzarella and a little of the parmiggiano over the mushrooms, and spoon a thin layer of the sauce over all.&nbsp;"
    },
    {
      "_id": "6850a87032ecade4c7b8ada7",
      "step": "Make 3 more layers this way. Top with a fifth layer of crespelle and spoon a final layer of sauce over them. Sprinkler with the remaining parmiggiano."
    },
    {
      "_id": "6850a87832ecade4c7b8ada8",
      "step": "Bake the lasagne for 25-30 minutes, or until it is hot and bubbly and then cheese on top is melted and lightly browned. Let stand for 5 minutes before serving. Serve immediately."
    },
    {
      "_id": "6850a88132ecade4c7b8ada9",
      "step": "The lasagne may be assembled and stored, unbaked, in the fridge for up to 2 days or in the freezer for up to 1 month. If frozen, remove from the freezer and let thaw overnight in the fridge. Bring the dish to room temperate before baking."
    }
  ],
  "__v": 27
