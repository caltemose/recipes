  "directions": [
    {
      "_id": "6851f2e232ecade4c7b8ae64",
      "step": "If using fresh sausages, preheat an oven to 375 degrees F. Prick with a fork and place on a baking sheet. Bake until firm, about 25 minutes. Remove from the oven, let cool slightly, then slice 1/4 inch thick. Set aside."
    },
    {
      "_id": "6851f2ec32ecade4c7b8ae65",
      "step": "In a large saucepan over medium heat, warm the olive oil. Add the onion and sauce until tender, about 8 minutes. Add the potatoes and garlic and sauce for a few minutes, stirring often. Add the water and 2 t salt, cover, reduce the heat to low, and simmer until the potatoes are very soft, about 20 minutes."
    },
    {
      "_id": "6851f2ec32ecade4c7b8ae66",
      "step": "Ladle the soup into bowls, drizzle each serving with 1 t olive oil, and serve at once."
    },
    {
      "_id": "6851f2ec32ecade4c7b8ae67",
      "step": "Mash the potatoes to a puree with a wooden spoon or potato masher. Add the sausage and cook over low heat for 5 minutes longer to warm through. Add the greens, stir well, and simmer, uncovered, for 3-5 minutes. Do not overcook. The greens should stay bright green and slightly crunchy. Season with salt and pepper."
    }
  ],
  "__v": 15
