  "directions": [
    {
      "_id": "685343cb32ecade4c7b8aec8",
      "step": "Cook the floury potatoes in salted water until tender, allow to steam slightly in a closet pot. Peel and mash."
    },
    {
      "_id": "685343d932ecade4c7b8aec9",
      "step": "Dissolve the yeast with sugar in 200 ml (1 C) lukewarm water. Mix the flour with 10 g (2 g) of sea salt. Add the potatoes, 20 ml (4 t) of olive oil and the dissolved yeast and knead with the hands only until everything is mixed together and a dough forms. Form the dough into a ball and place in a bowl. Cover and leave to rise for 5 hours in a warm draft-free place."
    },
    {
      "_id": "685343e232ecade4c7b8aeca",
      "step": "Sprinkle some semolina on baking paper. Carefully drop the dough onto the paper, drizzle with a little olive oil and spread with the fingers into a rectangular shape. Lighting ly press the olives and tomatoes into the dough. Sprinkler over some sea salt flakes and let the dough rest for 30 minutes away from any drafts."
    },
    {
      "_id": "685343e932ecade4c7b8aecb",
      "step": "Preheat the oven and the oven tray to 220 C (425 F)."
    },
    {
      "_id": "685343f232ecade4c7b8aecc",
      "step": "Place the focaccia with the baking paper on the hot oven tray and bake for about 40 minutes in the middle of the oven until golden brown. Remove from the oven, drizzle immediately with a little olive oil and serve."
    }
  ],
  "__v": 17
