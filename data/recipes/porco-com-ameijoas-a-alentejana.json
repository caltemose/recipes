  "directions": [
    {
      "_id": "685556dc32ecade4c7b8aee9",
      "step": "Place the pork in a non aluminum container and add the 1 cup whine, paprika, bay leaf, cloves, and 3 of the garlic cloves. Toss well to mix evenly, cover, and refrigerate overnight."
    },
    {
      "_id": "685556eb32ecade4c7b8aeea",
      "step": "The next day, drain the pork, reserving the marinade. Pat the meat dry."
    },
    {
      "_id": "685556f232ecade4c7b8aeeb",
      "step": "In a large frying pan over medium heat, warm 2 T olive oil. Working in batches, brown the pork cubes on all sides until golden brown, about 5 minutes. Using a slotted spoon, transfer to a plate."
    },
    {
      "_id": "685556fa32ecade4c7b8aeec",
      "step": "In a large saucepan over medium heat, warm 2 T olive oli. Add the onions and sate until soft, 8-10 minutes. Add the remaining 2 cloves garlic and the tomatoes and cook, stirring occasionally, until the tomatoes are soft, about 5 minutes. Add the browned pork to the onion mixture along with the reserved marinade, cover, reduce the heat to low, and cook until the pork is tender, about 1 hour. Check from time to time and add more wine if the pork threatens to scorch."
    },
    {
      "_id": "6855570032ecade4c7b8aeed",
      "step": "Add the clams, discarding any that are open or have broken shells, cover, raise the heat to high, and cook until the clams open, about 5 minutes. (Discard any clams that fail to open.)"
    },
    {
      "_id": "6855570732ecade4c7b8aeee",
      "step": "Transfer the pork and clams to a warmed serving dish and sprinkler with cilantro and parsley. Serve immediately."
    }
  ],
  "__v": 20
}