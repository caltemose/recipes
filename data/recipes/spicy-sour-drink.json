  "directions": [
    {
      "_id": "6855dafc32ecade4c7b8af51",
      "step": "Blend mint leaves, tamarind sauce, cumin powder, black salt, salt, and cayenne pepper in Cuisinart until a paste-like consistency forms."
    },
    {
      "_id": "6855db0332ecade4c7b8af52",
      "step": "Combine mint paste and water. Mix well."
    },
    {
      "_id": "6855db0b32ecade4c7b8af53",
      "step": "Refrigerate for 4 hours or more. Stir before serving. Serve in small glasses with a carrot stick for stirring."
    }
