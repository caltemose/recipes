  "directions": [
    {
      "_id": "6850aac032ecade4c7b8adc7",
      "step": "Put the olive oil and garlic in a large, heavy-bottomed saucepan and place over medium heat. Cook, turning the garlic frequently and using a wooden spoon or silicone spatula to press it into the oil, for about 5 minutes, or until the garlic is fragrant and beings to turn gold. remove and discard the garlic.&nbsp;"
    },
    {
      "_id": "6850aac832ecade4c7b8adc8",
      "step": "Add the pancetta and sauce, stirring frequently, for about 5 minutes or until it being to crisp and brown. Stir in the onion and rosemary and sauce, stirring frequently, for about 7 minutes, or until the onion is wilted."
    },
    {
      "_id": "6850aad032ecade4c7b8adc9",
      "step": "Pour in the tomatoes and bring the sauce to a boil. Reduce the heat to medium-low and let the sauce simmer gently for about 30 minutes or until thickened. Season with salt."
    }
  ],
