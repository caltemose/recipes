  "directions": [
    {
      "_id": "68569bda32ecade4c7b8afb7",
      "step": "Combine water and barley in a medium saucepan, cover and bring to a boil over high heat. Reduce heat to low and simmer for 30 minutes."
    },
    {
      "_id": "68569be132ecade4c7b8afb8",
      "step": "Peel lemons with a vegetable peeler, being careful to avoid the bitter white pith. Juice the lemons into a 3-quart pitcher and add the lemon peel."
    },
    {
      "_id": "68569be732ecade4c7b8afb9",
      "step": "Strain the barley water through a fine-mesh strainer into the pitcher. Add the honey and stir to combine. Refrigerate until chilled."
    },
