  "directions": [
    {
      "_id": "6851e96232ecade4c7b8adec",
      "step": "Pour the milk into a saucepan and bring just to a boil over medium heat. Do not let it boil over. Remove the pan from the heat."
    },
    {
      "_id": "6851e97032ecade4c7b8aded",
      "step": "Melt the butter in a heavy-bottomed saucepan over medium heat. Whisk in the flour and cook, stirring constantly, for 2 minutes. Add the hot milk in driblets, whisking constantly and taking care to avoid lumps and scorching."
    },
    {
      "_id": "6851e97a32ecade4c7b8adee",
      "step": "When all of the milk has been added, cook the sauce, stirring frequently with a wooden spoon or silicone spatula, for 10-13 minutes or until it is thick enough to coat the back of the spoon. Season with salt, pepper and nutmeg and remove from the heat."
    },
    {
      "_id": "6851e98732ecade4c7b8adef",
      "step": "The sauce may be stored in a tightly lidded container in the fridge for up to 3 days. Reheat it in a scalepan over low heat, adding a splash or two of milk if necessary to loosen it."
    }
  ],
  "__v": 14
