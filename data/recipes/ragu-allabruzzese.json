  "directions": [
    {
      "_id": "6850a66632ecade4c7b8ad86",
      "step": "<div>Warm the vegetable oil in a large Dutch oven or other heavy-bottomed pot placed over medium heat. Season the pieces of meat with salt and pepper and add them to the pot. Brown for 3-4 minutes, then turn the pieces to brown the other side, another 3-4 minutes. Remove the pieces to a deep plate or bowl. Set the pot aside.</div>"
    },
    {
      "_id": "6850a67532ecade4c7b8ad87",
      "step": "Pass the tomatoes through a food mill fitted with the disk with the smallest holes. Discard the solids. Set the milled tomatoes aside."
    },
    {
      "_id": "6850a67d32ecade4c7b8ad88",
      "step": "Return the pot to medium heat and add the extra-virgin olive oil.&nbsp; Stir in the onion, reduce the heat to medium-low, and sautéed for about 5 minutes, or until the onion is shiny and beginning to soften.&nbsp;"
    },
    {
      "_id": "6850a68532ecade4c7b8ad89",
      "step": "Pour in the tomatoes, raise the heat to medium-high, and bring to a simmer."
    },
    {
      "_id": "6850a68e32ecade4c7b8ad8a",
      "step": "Return the meat to the pot and reduce the heat to medium-low or low to maintain a gentle simmer.&nbsp; Cover partially and let the sauce simmer, stirring it from time to time, for about 3 hours, or until the meat is very tender and the sauce is thickened.&nbsp;"
    },
    {
      "_id": "6850a69632ecade4c7b8ad8b",
      "step": "Add a splash or two of water if the sauce thickens too much before the meat is done. Taste and adjust the seasoning with salt and pepper, if you like."
    },
    {
      "_id": "6850a69632ecade4c7b8ad8c",
      "step": "Turn off the heat. Remove the meat from the pot before using the sauce. Serve the sauce over pasta alla chittara. Serve the meat as a second course, or save it as a stuffing for cannelloni or ravioli."
    },
    {
      "_id": "6850a6a732ecade4c7b8ad8d",
      "step": "The sauce can be stored in the fridge for 3 days or in the freezer for 3 months."
    }
  ],
  "__v": 19
}