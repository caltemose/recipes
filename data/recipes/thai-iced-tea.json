  "directions": [
    {
      "_id": "68569cab32ecade4c7b8afc9",
      "step": "Bring water to boil in a 2-quart saucepan. Remove from the boil and add tea bags, tamarind, cardamom, cloves, star anise, cinnamon, vanilla and salt."
    },
    {
      "_id": "68569cb132ecade4c7b8afca",
      "step": "Cover pan with a lid and steep for 20 minutes."
    },
    {
      "_id": "68569cb732ecade4c7b8afcb",
      "step": "Remove tea bags and strain out spices. Add sugar and stir to dissolve."
    },
    {
      "_id": "68569cbd32ecade4c7b8afcc",
      "step": "Chill for at least 8 hours. Serve over ice with a splash of half-and-half."
    }
  ],
  "__v": 18
