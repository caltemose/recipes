  "directions": [
    {
      "_id": "68533edb32ecade4c7b8ae78",
      "step": "<div>Stir the mascarpone and the pistachio cream until smooth and keep it cool in the fridge for about 30 minutes.</div>"
    },
    {
      "_id": "68533ee832ecade4c7b8ae79",
      "step": "Peel and fillet the oranges."
    },
    {
      "_id": "68533ef132ecade4c7b8ae7a",
      "step": "Arrange the orange pieces on 4 plates. Dollop the pistachio cream on top, sprinkle with chopped pistachios and several sea salt flakes and a little ground black pepper. Garnish with several basil leaves and drizzle with a splash of olive oil."
    }
  ],
