  "directions": [
    {
      "_id": "6850987832ecade4c7b8ad64",
      "step": "Put the flour in a large bowl."
    },
    {
      "_id": "6850988032ecade4c7b8ad65",
      "step": "In a separate large bowl, whisk together the eggs, milk, parsley, salt, pepper, and nutmeg."
    },
    {
      "_id": "6850988832ecade4c7b8ad66",
      "step": "Gradually pour the egg mixture into the flour, whisking all the while to prevent lumps from forming. When the batter is smooth, cover the bowl with plastic wrap and let the batter rest at room temperature for 30 minutes."
    },
    {
      "_id": "6850989232ecade4c7b8ad67",
      "step": "Melt a little of the butter in a 9-in nonstick frying pan (or cast iron pan) placed over medium heat, tilting the pan to cover the bottom with a thin film.&nbsp;"
    },
    {
      "_id": "6850989a32ecade4c7b8ad68",
      "step": "When the pan is hot, pour in a small ladleful of batter (about 1/4 cup) and gently but quickly swirl it around so that it completely coats the bottom of the pan, forming a thin pancake. Cook for 30-45 seconds, or until just set. Flip the pancake and cook for 20-30 seconds longer, then transfer it to a plate.&nbsp;"
    },
    {
      "_id": "685098a332ecade4c7b8ad69",
      "step": "Continue making crepes until you have used all the batter, making sure to grease the pan lighting from time to time with a thin film of butter."
    },
    {
      "_id": "685098b532ecade4c7b8ad6a",
      "step": "If you are not using the crespelle immediately, wrap them tightly in plastic wrap and refrigerate for up to 3 days or freeze for up to 1 month."
    }
  ],
  "__v": 18
}