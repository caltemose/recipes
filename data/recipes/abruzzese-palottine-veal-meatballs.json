  "directions": [
    {
      "_id": "6850996f32ecade4c7b8ad72",
      "step": "Put the veal, salt, nutmeg and egg in a bowl and mix together thoroughly with your hands."
    },
    {
      "_id": "6850998032ecade4c7b8ad73",
      "step": "With your fingers, pinch off a very small piece of the mixture and roll it into a tiny ball - not much larger than a chickpea. Place the meatball on a clean tray or platter. Repeat until you have rolled all of the veal mixture into meatballs."
    },
    {
      "_id": "6850998832ecade4c7b8ad74",
      "step": "Pour the vegetable oil to a depth of 1/4 inch in a frying pan, place over medium-high heat, and heat to 375 degrees F on a deep-frying thermometer. If you don't have a thermometer, carefully drop a meatball into the hot oil; if it sizzles on contact, the oil is ready."
    },
    {
      "_id": "6850999032ecade4c7b8ad75",
      "step": "Place a platter lined with a double layer of paper towels near the stove."
    },
    {
      "_id": "6850999832ecade4c7b8ad76",
      "step": "Carefully add the meatballs to the hot oil, working in batches to avoid crowding the pan. Fry them, turning them from time to time with a spatula, slotted spoon, or fork, for about 4 minutes, or until they are lightly browned."
    },
    {
      "_id": "685099a132ecade4c7b8ad77",
      "step": "Remove the meatballs to a prepared platter. Repeat until all the meatballs are fried."
    },
    {
      "_id": "685099b032ecade4c7b8ad78",
      "step": "Transfer the meatballs to a pot with Abruzzese ragu. Serve over pasta alla chittara."
    },
    {
      "_id": "685099b632ecade4c7b8ad79",
      "step": "Meatballs can also be stored in a tight container in the fridge for up to 3 days or in the freezer for up to 1 month."
    }
  ],
  "__v": 16
