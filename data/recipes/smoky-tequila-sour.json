  "directions": [
    {
      "_id": "68569a5d32ecade4c7b8af99",
      "step": "Fill an old-fashioned with ice and set aside."
    },
    {
      "_id": "68569a6332ecade4c7b8af9a",
      "step": "Cut a wedge from one of the limes and reserve, then juice both limes into a cocktail shaker. Add tequila, Montenegro, orange juice, agave nectar and half a dozen or so ice cubes. Cover and shake for 30 seconds."
    },
    {
      "_id": "68569a6a32ecade4c7b8af9b",
      "step": "Strain the mixture through the cocktail strainer into the glass. Add liquid smoke, garnish with lime wedge."
    }
  ],
