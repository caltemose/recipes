  "directions": [
    {
      "_id": "68533fd032ecade4c7b8ae84",
      "step": "Strain the ricotta through a sieve, stir well with the cream in a pot and heat (do not boil). Beat the egg yolks, sugar, vanilla and a pinch of salt to a light cream."
    },
    {
      "_id": "68533fd932ecade4c7b8ae85",
      "step": "Prepare a bowl of water with ice cubes. Gradually stir the warm ricotta cream into the creamy egg mixture. Whisk the cream in a metal bowl on top of a double boiler until creamy, taking care that the mixture does not get too hot and bubbles form. After about 20 minutes, place the bowl in the icy water and stir the cream until it has completely cooled."
    },
    {
      "_id": "68533fe332ecade4c7b8ae86",
      "step": "Pour the cream into a pre-cooled, metal bowl with a tight lid. Freeze the ice cream for at least 5 hours. After 1-1/2 hours, and then every 30 minutes, stir well with a fork."
    },
    {
      "_id": "68533fec32ecade4c7b8ae87",
      "step": "Place the marmalade in four serving bowls, add a scoop of ricotta ice cream on top, sprinkle with a few flakes of sea salt, drizzle with a dash of olive oil and serve immediately."
    }
  ],
  "__v": 15
