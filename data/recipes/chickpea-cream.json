  "directions": [
    {
      "_id": "6853448032ecade4c7b8aed7",
      "step": "Soak the chickpeas overnight in plenty of water.&nbsp;"
    },
    {
      "_id": "6853448932ecade4c7b8aed8",
      "step": "Drain the water from the chickpeas, rinse them and put them in about 1.3 l (5-1/2 C) of water with the shallot, bay leaf, baking soda and celery and cook over a medium heat for about 1-2 hours. Add more water if necessary."
    },
    {
      "_id": "6853449132ecade4c7b8aed9",
      "step": "Drain the chickpeas, retain the liquid. Put the chickpeas into a mixer, season with a little salt and lemon juice, and blend. Add some cooking liquid until the desired consistency is achived. Season the creamy mixture again with pepper, salt and lemon juice and keep warm."
    },
    {
      "_id": "6853449932ecade4c7b8aeda",
      "step": "Serve as a bed for beef or other protein or veggies."
    }
  ],
  "__v": 15
