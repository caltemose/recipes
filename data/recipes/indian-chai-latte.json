  "directions": [
    {
      "_id": "6856a12a32ecade4c7b8b00d",
      "step": "Lightly crush the whole spices and add to one cup of water with the loose tea. Bring the water just to a boil, then turn off the heat and let steep for 10 minutes. (Boiling the tea will make it bitter, so just bring it to a boil.)&nbsp;"
    },
    {
      "_id": "6856a12f32ecade4c7b8b00e",
      "step": "Add milk and bring to a boil again."
    },
    {
      "_id": "6856a13532ecade4c7b8b00f",
      "step": "&nbsp;Strain using a tea strainer. Add sugar to taste."
    }
  ],
