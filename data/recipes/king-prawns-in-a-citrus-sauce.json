  "directions": [
    {
      "_id": "685340b432ecade4c7b8ae93",
      "step": "Peel and de-vein the prawns, then rinse. Put the citrus fruit juice, garlic, several basil leaves and the prawns in a container. Close the container firmly or cover with plastic wrap and marinate in the fridge for at least 3 hours."
    },
    {
      "_id": "685340bd32ecade4c7b8ae94",
      "step": "In a large, high-sided pan, heat up some olive oil. Add the prawns with the marinade and bring them to a simmer on a medium heat for about 2-3 minutes each side. Remove the prawns from the pan, keep warm. Bring the sauce to a boil with the sugar. Season with salt and pepper. Turn off the heat and return the shrimps to the sauce for about 1 minute and let them steep."
    },
    {
      "_id": "685340c632ecade4c7b8ae95",
      "step": "Arrange the prawns on plates with the sauce, sprinkle with the remaining basil leaves, drizzle with a good splash of olive oil and serve immediately."
    }
  ],
  "__v": 15
